# =====================================================
# MMR Pipeline environment example
# Copy this file to .env and fill in real values.
# =====================================================

# -----------------------------------------------------
# 1) Runtime mode
# -----------------------------------------------------
# Current test mode: DB -> DB
# Future service mode: api -> api
MMR_DATA_SOURCE=db
MMR_RESULT_SINK=db

# -----------------------------------------------------
# 2) Database
# -----------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=league
DB_USER=postgres
DB_PASSWORD=changeme

# Input tables used when MMR_DATA_SOURCE=db
MMR_PLAYER_GAME_TABLE=player_game
MMR_PLAYER_TABLE=player

# Output tables used when MMR_RESULT_SINK=db
MMR_MATCH_RESULT_TABLE=mmr_match_results
MMR_SUMMARY_TABLE=mmr_user_summary

# -----------------------------------------------------
# 3) Backend API
# -----------------------------------------------------
# Used when MMR_DATA_SOURCE=api or MMR_RESULT_SINK=api
API_BASE_URL=https://api.example.com
API_TOKEN=

# -----------------------------------------------------
# 4) Optional local output path
# -----------------------------------------------------
OUTPUT_DIR=./output
