# =====================================================
# GMOK MMR 환경변수 예시
# =====================================================
#
# 사용 방법:
#   1. 이 파일을 복사해 .env를 만든다.
#   2. DB/API secret과 실행 범위를 .env 또는 배포 secret에 입력한다.
#   3. .env는 Git에 커밋하지 않는다.
#
# 주의:
#   - DATABASE_URL이 설정되어 있으면 DB_HOST/DB_PORT/DB_NAME/DB_USER/
#     DB_PASSWORD보다 DATABASE_URL을 우선 사용한다.
#   - 운영 실행 시 로컬 개발용 .env가 아닌 운영 secret을 사용한다.
# =====================================================


# -----------------------------------------------------
# 1) 데이터 입출력 모드
# -----------------------------------------------------
# 기존 배치/adapter의 기본 모드다.
#   db  : PostgreSQL에서 원천 데이터를 읽고 PostgreSQL에 결과 저장
#   api : backend API에서 원천 데이터를 읽고 backend API에 결과 전송
#
# scripts/run_mmr_once.py는 DB 일회성 실행 스크립트이므로
# 아래 두 값은 db로 둔다.
MMR_DATA_SOURCE=db
MMR_RESULT_SINK=db


# -----------------------------------------------------
# 2) PostgreSQL 접속 정보
# -----------------------------------------------------
# 선택 1: 배포 환경에서 하나의 URL로 주입
# DATABASE_URL=postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>:5432/<DATABASE>

# 선택 2: 개별 환경변수로 주입
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=


# -----------------------------------------------------
# 3) 원천/결과 테이블
# -----------------------------------------------------
# 현재 DB 원천 데이터 구조 기준
MMR_PLAYER_GAME_TABLE=mmr_participant_metric
MMR_PLAYER_TABLE=riot_account
MMR_GUILD_MEMBER_TABLE=guild_member

# MMR 계산 결과 저장 테이블
MMR_MATCH_RESULT_TABLE=mmr_match_results
MMR_SUMMARY_TABLE=mmr_user_summary

# baseline 저장 테이블
# migrations/db_test/001_create_mmr_baselines.sql 실행 후 사용한다.
MMR_BASELINE_TABLE=mmr_baselines

# 기존 DB 테스트 실행 스크립트가 사용하는 실행 로그 테이블
# scripts/run_mmr_once.py는 이 테이블에 기록하지 않는다.
MMR_TEST_RUN_LOG_TABLE=mmr_test_run_log


# -----------------------------------------------------
# 4) MMR 일회성 실행 설정
# -----------------------------------------------------
# scripts/run_mmr_once.py 실행 시 필수
MMR_SEASON=
MMR_BASELINE_VERSION=

# 선택값
#   값을 입력하면 해당 guild_id만 계산한다.
#   비워두면 전체 guild의 데이터를 계산한다.
MMR_GUILD_ID=

# 실행 식별자
# 비워두면 season, baseline_version, guild 범위로 자동 생성한다.
MMR_CALCULATION_ID=

# 이 스크립트는 항상 baseline과 MMR 결과를 DB에 저장한다.
# 실행 전 결과 테이블과 baseline 테이블 migration을 적용해야 한다.

# 결과 JSON 저장 경로
# 비워두면 ./output/{MMR_CALCULATION_ID}.json에 저장한다.
# 상대경로는 프로젝트 루트 기준으로 처리한다.
# MMR_OUTPUT_FILE=./output/mmr-once.json


# -----------------------------------------------------
# 5) Backend API 연동용 설정
# -----------------------------------------------------
# MMR_DATA_SOURCE=api 또는 MMR_RESULT_SINK=api일 때 사용한다.
API_BASE_URL=
API_TOKEN=


# -----------------------------------------------------
# 6) 공통 로컬 출력 경로
# -----------------------------------------------------
# MMR_OUTPUT_FILE을 지정하지 않은 경우 기본 경로로 사용한다.
OUTPUT_DIR=./output
